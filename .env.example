# Supabase Configuration (PUBLIC keys only - safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Corporate Email Domain (only emails from this domain can register/login)
VITE_ALLOWED_EMAIL_DOMAIN=immenseair.com

# SECURITY WARNING:
# - NEVER put the Supabase service-role key here
# - NEVER commit .env files to Git
# - The anon key is safe for frontend (RLS protects your data)
# - Credential encryption key is set SERVER-SIDE in PostgreSQL config:
#   ALTER DATABASE postgres SET app.encryption_key = 'your-secret-key';
